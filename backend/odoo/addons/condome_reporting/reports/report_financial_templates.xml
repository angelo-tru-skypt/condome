<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_financial_document">
<t t-call="web.html_container">
<t t-set="head">
<style type="text/css">
body {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 10pt;
    color: #2D2620;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
}
table { -webkit-print-color-adjust: exact !important; }
</style>
</t>

<t t-foreach="docs" t-as="doc">
<t t-set="p" t-value="doc.get_report_payload()"/>
<div class="page" style="padding: 0; margin: 0;">

    <!-- ============================================================
         LOGO - centrado en fondo blanco
    ============================================================= -->
    <div style="text-align:center; padding:24px 0 18px 0; border-bottom:3px solid #D94F10;">
        <img src="data:image/svg+xml;base64," alt="Condome" style="height:60px; width:auto;"/>
    </div>

    <!-- ============================================================
         TITULO CENTRADO
    ============================================================= -->
    <div style="text-align:center; padding:20px 40px 18px 40px; background-color:#FCFAF8; border-bottom:2px solid #F0E8E1;">
        <div style="display:inline-block; background:#FFF2EB; color:#D94F10; font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; padding:3px 14px; border-radius:20px; border:1px solid #FDDCC9; margin-bottom:8px;">
            Reporte Oficial
        </div>
        <br/>
        <div style="font-size:22pt; font-weight:bold; color:#1F1A16; margin-bottom:4px;">
            <t t-esc="p.get('title', 'Reporte Administrativo')"/>
        </div>
        <div style="font-size:9pt; color:#8C8177; font-weight:bold; text-transform:uppercase; letter-spacing:2px;">
            <t t-esc="p.get('subtitle', 'Gestion Residencial')"/>
        </div>
    </div>

    <!-- ============================================================
         CONTENIDO
    ============================================================= -->
    <div style="padding:30px 40px 20px 40px;">

        <!-- === METADATOS (3 columnas) =========================== -->
        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
            Datos del Reporte
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6D9CD; margin-bottom:30px;">
            <tr>
                <td width="33%" style="padding:14px 20px; vertical-align:top; border-right:1px solid #E6D9CD;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:4px;">Condominio</span>
                    <span style="display:block; font-size:12pt; font-weight:bold; color:#1F1A16;"><t t-esc="p.get('scopeName', '-')"/></span>
                </td>
                <td width="33%" style="padding:14px 20px; vertical-align:top; border-right:1px solid #E6D9CD;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:4px;">Fecha de Generacion</span>
                    <span style="display:block; font-size:12pt; font-weight:bold; color:#1F1A16;"><t t-esc="p.get('generatedAt', '-')"/></span>
                </td>
                <td width="34%" style="padding:14px 20px; vertical-align:top;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:4px;">ID Reporte</span>
                    <span style="display:block; font-size:12pt; font-weight:bold; color:#1F1A16;"><t t-esc="doc.id"/></span>
                </td>
            </tr>
        </table>

        <!-- === KPI CARDS (4 columnas) =========================== -->
        <t t-if="p.get('cards')">
            <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
                Indicadores Clave
            </div>
            <table width="100%" cellpadding="0" cellspacing="8" style="margin-bottom:30px;">
                <tr>
                    <t t-foreach="p.get('cards', [])" t-as="card">
                        <td width="25%" style="vertical-align:top;">
                            <div style="border:1px solid #E2D5CA; border-top:4px solid #D94F10; border-radius:6px; padding:16px 14px; background:#FFFFFF;">
                                <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#8C8177; margin-bottom:8px;">
                                    <t t-esc="card.get('label', '')"/>
                                </span>
                                <span style="display:block; font-size:16pt; font-weight:bold; color:#1F1A16; line-height:1.1; margin-bottom:4px;">
                                    <t t-esc="card.get('value', '-')"/>
                                </span>
                                <span style="display:block; font-size:8pt; color:#6D625A;">
                                    <t t-esc="card.get('helper', '')"/>
                                </span>
                            </div>
                        </td>
                    </t>
                </tr>
            </table>
        </t>

        <!-- === ANALISIS FINANCIERO (2 columnas) ================= -->
        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
            <t t-esc="p.get('analysisSectionTitle', 'Analisis Financiero y Cuotas')"/>
        </div>
        <table width="100%" cellpadding="0" cellspacing="10" style="margin-bottom:30px;">
            <tr>
                <!-- COLUMNA IZQUIERDA: Flujo de caja -->
                <td width="50%" style="vertical-align:top;">
                    <div style="border:1px solid #E6D9CD; border-radius:8px; padding:18px; background:#FFFFFF;">
                        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; text-align:center; border-bottom:1px solid #F0E8E1; padding-bottom:8px; margin-bottom:16px;">
                            <t t-esc="p.get('analysisLeftTitle', 'Flujo de Caja')"/>
                        </div>

                        <!-- Barra: Ingresos -->
                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:4px;">
                            <tr>
                                <td style="font-size:9pt; font-weight:bold; color:#2D2620;">
                                    <t t-esc="p.get('chart_income_label', 'Ingresos')"/>
                                </td>
                                <td style="font-size:9pt; font-weight:bold; color:#1F1A16; text-align:right;">
                                    <t t-esc="p.get('chart_income_val', '$45,000')"/>
                                </td>
                            </tr>
                        </table>
                        <div style="background:#F0E8E1; border-radius:4px; height:10px; width:100%; margin-bottom:14px;">
                            <div t-attf-style="background:#27AE60; border-radius:4px; height:10px; width:#{p.get('chart_income_width', 70)}%;"></div>
                        </div>

                        <!-- Barra: Egresos -->
                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:4px;">
                            <tr>
                                <td style="font-size:9pt; font-weight:bold; color:#2D2620;">
                                    <t t-esc="p.get('chart_expense_label', 'Egresos')"/>
                                </td>
                                <td style="font-size:9pt; font-weight:bold; color:#1F1A16; text-align:right;">
                                    <t t-esc="p.get('chart_expense_val', '$28,000')"/>
                                </td>
                            </tr>
                        </table>
                        <div style="background:#F0E8E1; border-radius:4px; height:10px; width:100%; margin-bottom:14px;">
                            <div t-attf-style="background:#E53935; border-radius:4px; height:10px; width:#{p.get('chart_expense_width', 45)}%;"></div>
                        </div>

                        <!-- Barra: Fondo de Reserva -->
                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:4px;">
                            <tr>
                                <td style="font-size:9pt; font-weight:bold; color:#2D2620;">
                                    <t t-esc="p.get('chart_reserve_label', 'Fondo Reserva')"/>
                                </td>
                                <td style="font-size:9pt; font-weight:bold; color:#1F1A16; text-align:right;">
                                    <t t-esc="p.get('chart_reserve_val', '$15,500')"/>
                                </td>
                            </tr>
                        </table>
                        <div style="background:#F0E8E1; border-radius:4px; height:10px; width:100%;">
                            <div t-attf-style="background:#F39C12; border-radius:4px; height:10px; width:#{p.get('chart_reserve_width', 25)}%;"></div>
                        </div>
                    </div>
                </td>

                <!-- COLUMNA DERECHA: Cuotas -->
                <td width="50%" style="vertical-align:top;">
                    <div style="border:1px solid #E6D9CD; border-radius:8px; padding:18px; background:#FFFFFF;">
                        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; text-align:center; border-bottom:1px solid #F0E8E1; padding-bottom:8px; margin-bottom:16px;">
                            <t t-esc="p.get('analysisRightTitle', 'Estado de Cuotas')"/>
                        </div>

                        <div style="text-align:center; background:#FCFAF8; border:1px dashed #D4C5B8; border-radius:8px; padding:22px 14px; margin-bottom:14px;">
                            <span style="display:block; font-size:34pt; font-weight:bold; color:#D94F10; line-height:1;">
                                <t t-esc="p.get('chart_status_center', p.get('chart_paid_pct', '85%'))"/>
                            </span>
                            <span style="display:block; font-size:8pt; font-weight:bold; color:#8C8177; text-transform:uppercase; letter-spacing:1px; margin-top:4px;">
                                <t t-esc="p.get('chart_status_center_label', 'Unidades al Dia')"/>
                            </span>
                        </div>

                        <table width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #F0E8E1;">
                            <tr>
                                <td width="50%" style="text-align:center; padding:10px 6px; font-size:9pt; font-weight:bold; color:#4E4640;">
                                    <span style="display:inline-block; width:9px; height:9px; border-radius:50%; background:#27AE60; margin-right:4px; vertical-align:middle;"></span>
                                    <b><t t-esc="p.get('chart_paid_label', 'Al Dia')"/></b>  <t t-esc="p.get('chart_paid_pct', '85%')"/>
                                </td>
                                <td width="50%" style="text-align:center; padding:10px 6px; font-size:9pt; font-weight:bold; color:#4E4640;">
                                    <span style="display:inline-block; width:9px; height:9px; border-radius:50%; background:#E53935; margin-right:4px; vertical-align:middle;"></span>
                                    <b><t t-esc="p.get('chart_unpaid_label', 'En Mora')"/></b>  <t t-esc="p.get('chart_unpaid_pct', '15%')"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>

        <!-- === INFORMACION DEL CONDOMINIO (3 columnas) ========== -->
        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
            Informacion del Condominio
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6D9CD; border-left:5px solid #D94F10; margin-bottom:30px;">
            <tr>
                <td width="33%" style="padding:18px 20px; vertical-align:top; border-right:1px solid #F0E8E1;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:6px;">Direccion</span>
                    <span style="display:block; font-size:11pt; font-weight:bold; color:#1F1A16; line-height:1.4;">
                        <t t-esc="p.get('address', 'No registrada')"/>
                    </span>
                </td>
                <td width="33%" style="padding:18px 20px; vertical-align:top; border-right:1px solid #F0E8E1;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:6px;">Correo de Contacto</span>
                    <span style="display:block; font-size:11pt; font-weight:bold; color:#1F1A16; line-height:1.4;">
                        <t t-esc="p.get('email', 'No disponible')"/>
                    </span>
                </td>
                <td width="34%" style="padding:18px 20px; vertical-align:top;">
                    <span style="display:block; font-size:7pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#A3968C; margin-bottom:6px;">Generado Por</span>
                    <span style="display:block; font-size:11pt; font-weight:bold; color:#1F1A16; line-height:1.4;">
                        <t t-esc="p.get('requestedBy', 'Administrador')"/>
                    </span>
                </td>
            </tr>
        </table>

        <!-- === NOTAS EJECUTIVAS ================================= -->
        <t t-if="p.get('note') and p.get('note') != 'No additional notes.'">
            <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
                Observaciones
            </div>
            <div style="background:#FFFBF8; border:1px solid #FDDCC9; border-left:4px solid #D94F10; border-radius:6px; padding:14px 20px; font-size:10pt; font-style:italic; font-weight:600; color:#4E4640; line-height:1.5; margin-bottom:30px;">
                <t t-esc="p.get('note')"/>
            </div>
        </t>

        <!-- === TABLA DE REGISTROS ================================ -->
        <div style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:2px; color:#D94F10; border-bottom:2px solid #F0E8E1; padding-bottom:8px; margin-bottom:14px;">
            Registro Detallado
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6D9CD; margin-bottom:10px;">
            <thead>
                <tr style="background-color:#F8F4F0;">
                    <t t-if="p.get('columns')">
                        <th t-foreach="p.get('columns', [])" t-as="col"
                            style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; padding:12px 16px; text-align:left; border-bottom:2px solid #E6D9CD;"
                            t-esc="col.get('label', '')"/>
                    </t>
                    <t t-else="">
                        <th style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; padding:12px 16px; text-align:left; border-bottom:2px solid #E6D9CD;">Descripcion</th>
                        <th style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; padding:12px 16px; text-align:left; border-bottom:2px solid #E6D9CD;">Fecha</th>
                        <th style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; padding:12px 16px; text-align:left; border-bottom:2px solid #E6D9CD;">Monto</th>
                        <th style="font-size:8pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; color:#4E4640; padding:12px 16px; text-align:left; border-bottom:2px solid #E6D9CD;">Estado</th>
                    </t>
                </tr>
            </thead>
            <tbody>
                <t t-if="p.get('rows')">
                    <tr t-foreach="p.get('rows', [])" t-as="row">
                        <td t-foreach="p.get('columns', [])" t-as="col"
                            style="font-size:10pt; font-weight:600; color:#2D2620; padding:12px 16px; border-bottom:1px solid #F0E8E1;"
                            t-esc="row.get(col.get('key', ''), '-')"/>
                    </tr>
                </t>
                <t t-else="">
                    <tr>
                        <td colspan="4" style="text-align:center; padding:36px; color:#A3968C; font-style:italic; font-size:10pt;">
                            No se encontraron registros para este periodo.
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

    </div><!-- /contenido -->

    <!-- ============================================================
         FOOTER
    ============================================================= -->
    <div style="border-top:2px solid #F0E8E1; margin:30px 40px 0 40px; padding:16px 0 24px 0; text-align:center;">
        <div style="font-size:9pt; font-weight:bold; color:#6D625A; margin-bottom:4px;">
            <t t-esc="p.get('footerNote', 'Documento confidencial para uso administrativo.')"/>
        </div>
        <div style="font-size:8pt; color:#A3968C;">
            Generado y verificado por el sistema Condome
        </div>
    </div>

</div><!-- /page -->
</t>
</t>
</template>

<record id="action_report_financial" model="ir.actions.report">
    <field name="name">Condome Administrative Report</field>
    <field name="model">condome.report.export</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">condome_reporting.report_financial_document</field>
    <field name="report_file">condome_reporting.report_financial_document</field>
    <field name="print_report_name">'Condome_Report_%s' % (object.id)</field>
    <field name="binding_model_id" ref="model_condome_report_export"/>
    <field name="binding_type">report</field>
</record>
</odoo>
