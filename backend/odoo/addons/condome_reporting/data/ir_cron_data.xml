<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_monthly_condo_reports" model="ir.cron">
            <field name="name">Condome: Generación Mensual de Reportes Financieros</field>
            <field name="model_id" ref="model_condome_report_export"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_monthly_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).replace(hour=1, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
