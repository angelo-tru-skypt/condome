# Condome backend local environment
# Copy this file to backend/.env and replace the Stripe values when needed.

# Stripe
PUBLISHED_KEY=
SECRET_KEY=
STRIPE_REQUEST_TIMEOUT_SECONDS=4
STRIPE_NETWORK_RETRIES=0

# SMTP principal
SMTP_EMAIL=no-reply@condome.local
APP_PASSWORD_SMTP=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_CONNECTION_TIMEOUT=10

# SMTP de respaldo
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=1025
SMTP_FALLBACK_EMAIL=no-reply@condome.local
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_USE_TLS=false
SMTP_FALLBACK_USE_AUTH=false

# Pagos de planes:
# direct  -> activa planes sin cobrar en Stripe, util para desarrollo local
# auto    -> usa Stripe si esta configurado y hace fallback directo cuando aplica
# stripe  -> obliga a usar Stripe
PLAN_PAYMENT_MODE=direct
